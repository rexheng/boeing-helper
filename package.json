{
  "name": "boeing-helper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"tsx watch server/index.ts\"",
    "dev:frontend": "vite",
    "build": "vite build --outDir dist",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "vercel-build": "vite build --outDir dist",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "start": "NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.3",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.5.10",
    "groq-sdk": "^1.1.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pizzip": "^3.2.0",
    "react": "^18.3.1",
    "react-datasheet-grid": "^4.11.6",
    "react-dom": "^18.3.1",
    "react-webcam": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
